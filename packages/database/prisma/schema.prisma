generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  RECRUITER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EnrollmentMode {
  FULL_CYCLE
  TESTING_ONLY
  MODULAR
}

enum PracticeIntegrityMode {
  TRAINING
  GRADED
}

enum IntegrityPolicy {
  STUDENT_CHOICE
  FORCED_TRAINING
  FORCED_GRADED
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
  ADVANCED
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  ANNULLED
  ERROR
}

enum TaskType {
  CODE
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT_ESSAY
  OPEN_TEXT
}

enum TeacherReviewStatus {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
  ANNULLED
  SUPERSEDED
}

enum CredentialType {
  SBT_ERC5192
  DNFT_ERC721
}

model CourseCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  icon        String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id                      String             @id @default(uuid())
  slug                    String             @unique
  title                   String
  description             String
  icon                    String?
  targetAudience          String?
  isPublished             Boolean            @default(true)
  defaultMasteryThreshold Float              @default(0.85)
  categoryId              String?
  category                CourseCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  modules                 CourseModule[]
  skills                  SkillNode[]
  classrooms              Classroom[]
  enrollments             CourseEnrollment[]

  @@map("courses")
}

model CourseModule {
  id                  String      @id @default(uuid())
  courseId            String
  course              Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  description         String?
  orderIndex          Int         @default(0)
  theoryUrl           String?
  minMasteryThreshold Float       @default(0.85)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  skills              SkillNode[]

  @@unique([courseId, slug])
  @@index([courseId, orderIndex])
  @@map("course_modules")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String?
  walletAddress      String?             @unique
  role               UserRole            @default(STUDENT)
  authProvider       AuthProvider        @default(LOCAL)
  googleId           String?
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            UserProfile?
  bktStates          BktState[]
  bktHistories       BktHistory[]
  telemetrySessions  TelemetrySession[]
  behavioralProfiles BehavioralProfile[]
  submissions        Submission[]
  credentials        Credential[]
  activityLogs       StudentActivityLog[]
  taughtClassrooms   Classroom[]         @relation("TeacherClassrooms")
  classrooms         Classroom[]         @relation("ClassroomStudents")
  courseEnrollments  CourseEnrollment[]

  @@index([googleId])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model SkillNode {
  id                 String            @id @default(uuid())
  courseId           String?
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  moduleId           String?
  module             CourseModule?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  slug               String            @unique
  title              String
  description        String
  category           String
  difficulty         TaskDifficulty    @default(EASY)
  orderIndex         Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tasks              Task[]
  bktStates          BktState[]
  bktHistories       BktHistory[]
  parentDependencies SkillDependency[] @relation("ChildSkill")
  childDependencies  SkillDependency[] @relation("ParentSkill")
  credentials        Credential[]

  @@index([courseId])
  @@index([moduleId])
  @@map("skill_nodes")
}

model SkillDependency {
  id              String    @id @default(uuid())
  parentSkillId   String
  parentSkill     SkillNode @relation("ParentSkill", fields: [parentSkillId], references: [id], onDelete: Cascade)
  childSkillId    String
  childSkill      SkillNode @relation("ChildSkill", fields: [childSkillId], references: [id], onDelete: Cascade)
  requiredMastery Float     @default(0.95)

  @@unique([parentSkillId, childSkillId])
  @@map("skill_dependencies")
}

model Task {
  id                String             @id @default(uuid())
  skillId           String
  skill             SkillNode          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  taskType          TaskType           @default(CODE)
  title             String
  description       String
  starterCode       String?
  options           Json?
  referenceAnswer   String?
  rubrics           Json?
  misconceptions    Json?
  socraticHints     Json?              // Array of authoring Socratic hints: [{ level: 1, hint: "...", penaltyPct: 15 }]
  studyUnitUrl      String?            // Deep-link anchor to Study App: "/learn/js-dev/module-1#const-mutability"
  difficulty        TaskDifficulty     @default(EASY)
  topic             String?
  subConcept        String?
  timeLimitMs       Int                @default(5000)
  memoryLimitMb     Int                @default(128)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testCases         TestCase[]
  submissions       Submission[]
  telemetrySessions TelemetrySession[]
  bktHistories      BktHistory[]

  @@map("tasks")
}

model TestCase {
  id             String  @id @default(uuid())
  taskId         String
  task           Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isSecret       Boolean @default(false)

  @@map("test_cases")
}

model BktState {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId       String
  skill         SkillNode @relation(fields: [skillId], references: [id], onDelete: Cascade)
  pMastery      Float     @default(0.1)
  pTransit      Float     @default(0.2)
  pSlip         Float     @default(0.1)
  pGuess        Float     @default(0.2)
  attemptsCount    Int                   @default(0)
  isMastered       Boolean               @default(false)
  masteredAt       DateTime?
  activeMode       PracticeIntegrityMode @default(TRAINING)
  gradedMastery    Float?
  gradedMasteredAt DateTime?
  updatedAt        DateTime              @updatedAt

  @@unique([userId, skillId])
  @@map("bkt_states")
}

model BktHistory {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId             String
  skill               SkillNode           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  taskId              String?
  task                Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  pMasteryBefore      Float
  pMasteryAfter       Float
  isCorrect           Boolean
  pSlipUsed           Float?
  pGuessUsed          Float?
  adjustReasons       String[]            @default([])
  semanticScore       Float?
  feedbackText        String?
  teacherReviewStatus TeacherReviewStatus @default(NONE)
  teacherComment      String?
  createdAt           DateTime            @default(now())

  @@map("bkt_histories")
}

model TelemetrySession {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId            String
  task              Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt         DateTime           @default(now())
  endedAt           DateTime?
  logs              TelemetryLog[]
  behavioralProfile BehavioralProfile?

  @@map("telemetry_sessions")
}

model TelemetryLog {
  id        String           @id @default(uuid())
  sessionId String
  session   TelemetrySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String
  eventData Json
  timestamp DateTime         @default(now())

  @@map("telemetry_logs")
}

model BehavioralProfile {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String           @unique
  session          TelemetrySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  typingSpeedWpm   Float            @default(0)
  pasteRatio       Float            @default(0)
  pauseDurationMs  Int              @default(0)
  trustCoefficient Float            @default(1.0)
  createdAt        DateTime         @default(now())

  @@map("behavioral_profiles")
}

model Submission {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  code                 String
  status               SubmissionStatus    @default(PENDING)
  teacherReviewStatus  TeacherReviewStatus @default(NONE)
  teacherComment       String?
  attemptNumber        Int                 @default(1)
  previousSubmissionId String?
  previousSubmission   Submission?         @relation("SubmissionVersions", fields: [previousSubmissionId], references: [id], onDelete: SetNull)
  nextSubmissions      Submission[]        @relation("SubmissionVersions")
  createdAt            DateTime            @default(now())
  evaluationResult     EvaluationResult?

  @@map("submissions")
}

model EvaluationResult {
  id              String     @id @default(uuid())
  submissionId    String     @unique
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  astPassed       Boolean    @default(false)
  unitTestsPassed Int        @default(0)
  unitTestsTotal  Int        @default(0)
  llmFeedback     String?
  llmScore        Float?
  createdAt       DateTime   @default(now())

  @@map("evaluation_results")
}

model Credential {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           SkillNode      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type            CredentialType @default(SBT_ERC5192)
  contractAddress String
  tokenId         String
  txHash          String
  tokenUri        String
  issuedAt        DateTime       @default(now())

  @@map("credentials")
}

model StudentActivityLog {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId      String    // ID of the user who initiated this action (student, teacher, admin or 'system')
  actorRole    UserRole  @default(STUDENT) // Role at time of action
  courseId     String?
  skillId      String?
  taskId       String?
  submissionId String?
  eventType    String    // E.g., 'HINT_REQUESTED', 'THEORY_DRAWER_OPENED', 'TEACHER_SUBMISSION_ANNULLED'
  payload      Json      // Flexible context & parameters
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([eventType])
  @@index([taskId])
  @@index([skillId])
  @@map("student_activity_logs")
}

model Classroom {
  id             String             @id @default(uuid())
  name           String
  code           String             @unique
  teacherId      String
  teacher        User               @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  defaultMode     EnrollmentMode     @default(FULL_CYCLE)
  allowedModules  String[]           @default([])
  integrityPolicy IntegrityPolicy    @default(STUDENT_CHOICE)
  strictModeUntil DateTime?
  createdAt       DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  students       User[]             @relation("ClassroomStudents")
  enrollments    CourseEnrollment[]

  @@index([teacherId])
  @@index([code])
  @@map("classrooms")
}

model CourseEnrollment {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classroomId    String?
  classroom      Classroom?     @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  mode                    EnrollmentMode   @default(FULL_CYCLE)
  allowedModules          String[]         @default([])
  integrityPolicyOverride IntegrityPolicy?
  isActive                Boolean          @default(true)
  enrolledAt     DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([classroomId])
  @@map("course_enrollments")
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}


