{
  "name": "smart-bkt-chain",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:studio": "prisma studio --schema=packages/database/prisma/schema.prisma",
    "db:seed": "npm run prisma:seed --workspace=@sbc/database",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "dev:docs": "npm run dev --workspace=apps/docs",
    "build:docs": "npm run build --workspace=apps/docs",
    "dev:student": "npm run dev --workspace=apps/student",
    "build:student": "npm run build --workspace=apps/student",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:admin": "npm run build --workspace=apps/admin",
    "test:e2e": "playwright test",
    "compile:docs": "python scripts/compile_docs.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
